<ui:MyPageRight xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:vm="using:PCL"
                xmlns:ui="using:PCL.UI.Controls"
                xmlns:loc="using:PCL.Core.UI"
                x:Class="PCL.Views.Pages.Instance.PageInstanceCompJarInJar"
                x:DataType="vm:PageInstanceCompJarInJarViewModel">
    <Grid>
        <ui:MyScrollViewer x:Name="PanBack"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMain"
                        Margin="25,10,25,10">
                <ui:MyCard x:Name="PanManage"
                           Margin="0,15,0,15">
                    <WrapPanel Margin="15,8,0,15">
                        <ui:MyButton x:Name="BtnBack"
                                     MinWidth="110"
                                     Margin="0,7,15,0"
                                     Padding="13,7"
                                     HorizontalAlignment="Left"
                                     ColorType="Highlight"
                                     Text="{loc:Loc Instance.Resource.BackToParent}" />
                        <ui:MyButton x:Name="BtnRefresh"
                                     MinWidth="110"
                                     Margin="0,7,15,0"
                                     Padding="13,7"
                                     HorizontalAlignment="Left"
                                     Text="{loc:Loc Common.Action.Refresh}" />
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,7,15,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrush2}"
                                   Text="{loc:Loc Instance.Resource.Mod.JarInJar.Message}" />
                    </WrapPanel>
                </ui:MyCard>

                <ui:MySearchBox x:Name="SearchBox"
                                Margin="0,0,0,15"
                                HintText="{loc:Loc Instance.Resource.Mod.JarInJar.Search.Hint}" />

                <ui:MyCard x:Name="CardWarnings"
                           Margin="0,0,0,15"
                           IsVisible="{Binding CardWarningsVisible}">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{loc:Loc Instance.Resource.Mod.JarInJar.Section.Warnings}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <StackPanel x:Name="PanWarnList"
                                    Margin="0,8,0,0" />
                    </StackPanel>
                </ui:MyCard>

                <ui:MyCard x:Name="CardConflicts"
                           Margin="0,0,0,15"
                           IsVisible="{Binding CardConflictsVisible}">
                    <StackPanel Margin="15,10,15,12">
                        <TextBlock Text="{loc:Loc Instance.Resource.Mod.JarInJar.Section.Conflicts}"
                                   ToolTip.Tip="{loc:Loc Instance.Resource.Mod.JarInJar.Conflict.Tooltip}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <StackPanel x:Name="PanConflictList"
                                    Margin="0,8,0,0" />
                    </StackPanel>
                </ui:MyCard>

                <StackPanel x:Name="SectionRelations"
                            IsVisible="{Binding SectionRelationsVisible}">
                    <TextBlock Text="{loc:Loc Instance.Resource.Mod.JarInJar.Section.Relations}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorBrush3}"
                               Margin="2,0,0,8" />
                    <StackPanel x:Name="PanRelationList" />
                </StackPanel>

                <StackPanel x:Name="SectionBundled"
                            IsVisible="{Binding SectionBundledVisible}">
                    <TextBlock Text="{loc:Loc Instance.Resource.Mod.JarInJar.Section.Bundled}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorBrush3}"
                               Margin="2,4,0,8" />
                    <StackPanel x:Name="PanBundledList" />
                </StackPanel>
            </StackPanel>
        </ui:MyScrollViewer>

        <ui:MyCard x:Name="PanEmpty"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="40"
                   IsVisible="{Binding PanEmptyVisible}">
            <StackPanel Margin="20,17">
                <TextBlock Margin="0,0,0,9"
                           HorizontalAlignment="Center"
                           Text="{loc:Loc Instance.Resource.Mod.JarInJar.Empty.Title}"
                           FontSize="19"
                           Foreground="{DynamicResource ColorBrush3}" />
                <Rectangle Height="2"
                           HorizontalAlignment="Stretch"
                           Fill="{DynamicResource ColorBrush3}" />
                <TextBlock Margin="10,10,10,0"
                           Text="{loc:Loc Instance.Resource.Mod.JarInJar.Empty.Message}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />
                <ui:MyButton x:Name="BtnEmptyBack"
                             Height="35"
                             MinWidth="130"
                             Margin="5,20,5,5"
                             Padding="12,0"
                             HorizontalAlignment="Center"
                             ColorType="Highlight"
                             Text="{loc:Loc Instance.Resource.BackToParent}" />
            </StackPanel>
        </ui:MyCard>

        <ui:MyCard x:Name="PanLoad"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="40,0"
                   UseAnimation="False"
                   IsVisible="{Binding PanLoadVisible}">
            <ui:MyLoading x:Name="Load"
                          Margin="20,20,20,17"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Text="{loc:Loc Instance.Resource.Mod.JarInJar.Loading}" />
        </ui:MyCard>
    </Grid>
</ui:MyPageRight>
